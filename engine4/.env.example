CI_ENVIRONMENT = production

# 앱 베이스 URL
app.baseURL = 'https://your-domain.com/engine4/public/'

# 데이터베이스 설정
database.default.hostname = localhost
database.default.database = pushwing
database.default.username = DB_USERNAME
database.default.password = DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.port     = 3306

# FCM Server Key (Google Firebase Cloud Messaging)
# GCM은 2019년 종료됨. Firebase Console > 프로젝트 설정 > 클라우드 메시징에서 발급
pushwing.fcmServerKey = YOUR_FCM_SERVER_KEY_HERE

# AES-256 암호화 키 (앱과 동일한 키 사용)
pushwing.cipherKey = YOUR_CIPHER_KEY_HERE
